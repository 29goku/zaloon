generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Appointment {
  id                 String               @id
  salonId            String
  clientId           String?
  staffId            String
  date               String
  startTime          String
  totalAmount        Float                @default(0)
  status             String               @default("SCHEDULED")
  notes              String?
  createdAt          DateTime             @default(now())
  Staff              Staff                @relation(fields: [staffId], references: [id])
  Client             Client?              @relation(fields: [clientId], references: [id])
  Salon              Salon                @relation(fields: [salonId], references: [id])
  AppointmentService AppointmentService[]
  Invoice            Invoice?
  Reminder           Reminder[]
}

model AppointmentService {
  appointmentId String
  serviceId     String
  Service       Service     @relation(fields: [serviceId], references: [id])
  Appointment   Appointment @relation(fields: [appointmentId], references: [id])

  @@id([appointmentId, serviceId])
}

model Client {
  id            String        @id
  salonId       String
  name          String
  phone         String?
  email         String?
  birthday      DateTime?
  anniversary   DateTime?
  notes         String?
  loyaltyPoints Int           @default(0)
  createdAt     DateTime      @default(now())
  Appointment   Appointment[]
  Salon         Salon         @relation(fields: [salonId], references: [id])
  Invoice       Invoice[]
  LedgerEntry   LedgerEntry[]
  Waitlist      Waitlist[]
}

model Invoice {
  id            String       @id
  salonId       String
  clientId      String?
  appointmentId String?      @unique
  total         Float
  paymentMethod String       @default("CASH")
  status        String       @default("PAID")
  createdAt     DateTime     @default(now())
  note          String?
  Appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  Client        Client?      @relation(fields: [clientId], references: [id])
  Salon         Salon        @relation(fields: [salonId], references: [id])
}

model LedgerEntry {
  id        String   @id
  clientId  String
  type      String
  amount    Float
  note      String?
  createdAt DateTime @default(now())
  Client    Client   @relation(fields: [clientId], references: [id])
}

model Reminder {
  id            String      @id
  appointmentId String
  type          String
  status        String      @default("PENDING")
  message       String
  scheduledAt   DateTime
  sentAt        DateTime?
  createdAt     DateTime    @default(now())
  Appointment   Appointment @relation(fields: [appointmentId], references: [id])
}

model Salon {
  id              String            @id
  name            String
  slug            String            @unique
  logo            String?
  address         String?
  city            String?
  country         String            @default("US")
  timezone        String            @default("UTC")
  currency        String            @default("USD")
  phone           String?
  email           String?
  taxRate         Float             @default(0)
  invoicePrefix   String            @default("INV")
  invoiceFooter   String?
  businessHours   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  Appointment     Appointment[]
  Client          Client[]
  Invoice         Invoice[]
  Service         Service[]
  ServiceCategory ServiceCategory[]
  Staff           Staff[]
  User            User[]
  Waitlist        Waitlist[]
}

model Service {
  id                 String               @id
  salonId            String
  categoryId         String
  name               String
  durationMins       Int                  @default(30)
  price              Float
  active             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  AppointmentService AppointmentService[]
  ServiceCategory    ServiceCategory      @relation(fields: [categoryId], references: [id])
  Salon              Salon                @relation(fields: [salonId], references: [id])
  StaffService       StaffService[]
  Waitlist           Waitlist[]
}

model ServiceCategory {
  id      String    @id
  salonId String
  name    String
  icon    String?
  Service Service[]
  Salon   Salon     @relation(fields: [salonId], references: [id])
}

model Shift {
  id        String @id
  staffId   String
  dayOfWeek Int
  startTime String
  endTime   String
  Staff     Staff  @relation(fields: [staffId], references: [id])
}

model Staff {
  id            String         @id
  salonId       String
  name          String
  phone         String?
  avatar        String?
  commissionPct Float          @default(0)
  createdAt     DateTime       @default(now())
  Appointment   Appointment[]
  Shift         Shift[]
  Salon         Salon          @relation(fields: [salonId], references: [id])
  StaffService  StaffService[]
  Waitlist      Waitlist[]
}

model StaffService {
  staffId   String
  serviceId String
  Service   Service @relation(fields: [serviceId], references: [id])
  Staff     Staff   @relation(fields: [staffId], references: [id])

  @@id([staffId, serviceId])
}

model User {
  id        String   @id
  salonId   String
  name      String
  email     String?
  phone     String?
  role      String   @default("RECEPTIONIST")
  createdAt DateTime @default(now())
  Salon     Salon    @relation(fields: [salonId], references: [id])
}

model Waitlist {
  id        String   @id
  salonId   String
  clientId  String?
  name      String
  phone     String?
  serviceId String?
  staffId   String?
  note      String?
  status    String   @default("WAITING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Salon     Salon    @relation(fields: [salonId], references: [id])
  Client    Client?  @relation(fields: [clientId], references: [id])
  Service   Service? @relation(fields: [serviceId], references: [id])
  Staff     Staff?   @relation(fields: [staffId], references: [id])
}
